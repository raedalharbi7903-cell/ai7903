APP_NAME=ai-trading-platform
APP_ENVIRONMENT=development
# Supported environments: development, testing, staging, production.
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./ai_trading_platform.db
# PostgreSQL uses postgresql+psycopg; inject actual credentials securely.
API_V1_PREFIX=/api/v1
# Private history stays disabled pending identity/privacy/retention approval.
HISTORY_ENABLED=false
HISTORY_MUTATIONS_ENABLED=false
# HISTORY_RETENTION_SECONDS=
# HISTORY_POLICY_REFERENCE=
# HISTORY_ALLOWED_ORIGIN=
# HISTORY_AUDIT_RETENTION_SECONDS=
# HISTORY_AUDIT_POLICY_REFERENCE=
# No identity provider is enabled. Set only after verified founder enrollment.
FOUNDER_IDENTITY_ISSUER=
FOUNDER_IDENTITY_SUBJECT=
# No market-data provider or commercial rights are approved.
# Selection and credentials alone do not authorize live access.
# MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
# MARKET_DATA_BASE_URL=
# Legacy CRYPTO_DEVELOPMENT_* settings are not used by the application.
